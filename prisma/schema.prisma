generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  WAITER
  CHEF
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  googleId     String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedRestaurants Restaurant[]         @relation("RestaurantOwner")
  memberships      RestaurantMember[]
  sentInvitations  RestaurantInvitation[] @relation("InvitedBy")

  @@map("users")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  address     String?
  phone       String?
  whatsapp    String?
  schedule    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("RestaurantOwner", fields: [ownerId], references: [id])

  members     RestaurantMember[]
  socialLinks RestaurantSocialLink[]
  invitations RestaurantInvitation[]

  @@map("restaurants")
}

model RestaurantMember {
  id        String     @id @default(cuid())
  role      MemberRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("restaurant_members")
}

model RestaurantSocialLink {
  id       String         @id @default(cuid())
  platform SocialPlatform
  handle   String

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, platform])
  @@map("restaurant_social_links")
}

model RestaurantInvitation {
  id          String           @id @default(cuid())
  email       String
  role        MemberRole
  status      InvitationStatus @default(PENDING)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([restaurantId, email])
  @@map("restaurant_invitations")
}
