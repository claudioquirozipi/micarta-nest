generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  WAITER
  CHEF
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
}

enum OrderStatus {
  PENDING
  COOKING
  READY
  SERVED
  FINISHED
  CANCELLED
}

enum OrderType {
  WHATSAPP
  TABLE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  avatarUrl    String?
  passwordHash String?
  googleId     String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedRestaurants Restaurant[]         @relation("RestaurantOwner")
  memberships      RestaurantMember[]
  sentInvitations  RestaurantInvitation[] @relation("InvitedBy")
  createdOrders    Order[]              @relation("OrderCreator")

  @@map("users")
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  address     String?
  phone       String?
  whatsapp    String?
  schedule    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation("RestaurantOwner", fields: [ownerId], references: [id])

  members     RestaurantMember[]
  socialLinks RestaurantSocialLink[]
  invitations RestaurantInvitation[]
  categories  Category[]
  dishes      Dish[]
  orders      Order[]

  @@map("restaurants")
}

model Category {
  id           String   @id @default(cuid())
  name         String
  position     Int      @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("categories")
}

model Dish {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  position     Int      @default(0)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("dishes")
}

model Order {
  id              String      @id @default(cuid())
  type            OrderType
  status          OrderStatus @default(PENDING)
  isPaid          Boolean     @default(false)
  tableNumber     String?
  customerName    String?
  customerPhone   String?
  customerAddress String?
  notes           String?
  total           Float

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  dishName  String
  dishPrice Float
  quantity  Int
  subtotal  Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId String?
  dish   Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model RestaurantMember {
  id        String     @id @default(cuid())
  role      MemberRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("restaurant_members")
}

model RestaurantSocialLink {
  id       String         @id @default(cuid())
  platform SocialPlatform
  handle   String

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, platform])
  @@map("restaurant_social_links")
}

model RestaurantInvitation {
  id          String           @id @default(cuid())
  email       String
  role        MemberRole
  status      InvitationStatus @default(PENDING)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])

  @@unique([restaurantId, email])
  @@map("restaurant_invitations")
}
